# Environment Variables Template - RT-CFAS v1
# Copy this to .env in apps/api and services/risk as needed. DO NOT COMMIT REAL SECRETS.

# Backend Server (apps/api)
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Hosted Postgres: Supabase / Neon / Local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rt_cfas

# Blockchain Data Provider (Etherscan API)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# Risk Scoring Service (services/risk)
RISK_SERVICE_URL=http://localhost:8000
